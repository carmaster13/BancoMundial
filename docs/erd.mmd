        INTEGER Anio_x4 "año de cada dato BM"
        TEXT TamanoPais "F3"
        REAL GastoSaludPctPIB "F3"
        TEXT NivelEsperanzaVida "F3"
        REAL BrechaEV_vsMundo "F3"
        REAL IndicePrioridad "F3"
        TEXT PrioridadFinanciamiento "F3"
    }
