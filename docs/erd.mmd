        TEXT CodigoPais PK "ISO3"
        TEXT Pais "Español"
        TEXT Country "Inglés corregido"
        TEXT Nombre_BancoMundial
        TEXT Continente
        TEXT Continent
        TEXT RegionBM
        TEXT GrupoIngresoBM
    }
    DimPeriodo {
        INTEGER Anio PK "2025"
        TEXT Descripcion
    }
    FactIndicadoresPais {
        TEXT CodigoPais PK,FK
        INTEGER Anio PK,FK
        INTEGER Poblacion
        REAL EsperanzaVida
        REAL MortalidadInfantil "por 1.000"
